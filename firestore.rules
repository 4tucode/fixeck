rules_version = '2';

// ===============================================================
// Modelo de datos que estas reglas dan por hecho
// ===============================================================
//
// Colección: users/{userId}/shifts
// Id del documento: automático
// Cada documento es una jornada de trabajo del usuario {userId}.
// Campos (no se admite ninguno más):
//   - startedAt: timestamp (obligatorio, no se puede cambiar). Hora de entrada.
//                La pone el servidor al crear el documento.
//   - endedAt:   timestamp o null (obligatorio). Hora de salida; null mientras la
//                jornada sigue abierta. La pone el servidor al cerrarla y, una vez
//                puesta, el documento ya no se puede modificar.
//
// Colección: users/{userId}/breaks
// Id del documento: automático
// Cada documento es una pausa dentro de una jornada del usuario {userId}.
// Campos (no se admite ninguno más):
//   - shiftId:   string (obligatorio, no se puede cambiar). Id de la jornada a la que
//                pertenece, que debe existir y estar abierta al crear la pausa.
//   - startedAt: timestamp (obligatorio, no se puede cambiar). Inicio de la pausa.
//                Lo pone el servidor al crear el documento.
//   - endedAt:   timestamp o null (obligatorio). Fin de la pausa; null mientras dura.
//                Lo pone el servidor al cerrarla y, una vez puesto, ya no se puede modificar.
//
// Documento: users/{userId}/private/clock
// Sirve para medir la diferencia entre el reloj del dispositivo y el del servidor.
// Campos (no se admite ninguno más):
//   - syncedAt: timestamp (obligatorio). Siempre la hora del servidor en el momento de escribir.
//
// Documento: users/{userId}
// Indica a qué empresa pertenece el usuario. Solo existe si se ha unido a una (o la ha creado).
// Campos (no se admite ninguno más):
//   - companyId: string (obligatorio, no se puede cambiar). Id de su empresa.
//
// Colección: companies
// Id del documento: automático. Como es largo y aleatorio, hace de invitación:
// solo puede unirse a la empresa quien recibe el enlace que lo contiene.
// Campos (no se admite ninguno más; el documento no se puede modificar):
//   - name:      string (obligatorio, de 1 a 60 caracteres). Nombre de la empresa.
//   - ownerId:   string (obligatorio). Uid del responsable: quien la creó.
//   - createdAt: timestamp (obligatorio). Lo pone el servidor.
//
// Colección: companies/{companyId}/members
// Id del documento: el uid del empleado
// Cada documento es una persona de la empresa (el responsable también es una de ellas).
// Campos (no se admite ninguno más; el documento no se puede modificar):
//   - name:     string (obligatorio, de 1 a 60 caracteres). Nombre con el que aparece en el equipo.
//   - email:    string (obligatorio). El correo de su cuenta, tomado de la sesión.
//   - joinedAt: timestamp (obligatorio). Lo pone el servidor.
//
// Consultas que hace la app:
//   - Jornada abierta: where('endedAt', '==', null), limit(1)
//   - Historial: orderBy('startedAt', 'desc'), limit(60)
//   - Pausas de la jornada abierta: where('shiftId', '==', id)
//   - Pausas del historial: orderBy('startedAt', 'desc'), limit(300)
//   - Equipo de una empresa: orderBy('name')
//
// Todo lo que no aparece aquí queda denegado por defecto.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------

    // Hay un usuario con sesión iniciada
    function isAuthenticated() {
      return request.auth != null;
    }

    // El usuario con sesión iniciada es el dueño de los datos de la ruta
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Forma válida de una jornada. Se comprueba al crear y al modificar, para que
    // un documento válido no pueda convertirse después en uno que no lo es
    function isValidShift(data) {
      return data.keys().hasAll(['startedAt', 'endedAt']) &&
             data.keys().hasOnly(['startedAt', 'endedAt']) &&
             data.startedAt is timestamp &&
             (data.endedAt == null ||
               (data.endedAt is timestamp && data.endedAt >= data.startedAt));
    }

    // Forma válida de una pausa. Igual que con las jornadas, se comprueba al crear y al modificar
    function isValidBreak(data) {
      return data.keys().hasAll(['shiftId', 'startedAt', 'endedAt']) &&
             data.keys().hasOnly(['shiftId', 'startedAt', 'endedAt']) &&
             data.shiftId is string &&
             data.shiftId.size() > 0 && data.shiftId.size() <= 64 &&
             data.startedAt is timestamp &&
             (data.endedAt == null ||
               (data.endedAt is timestamp && data.endedAt >= data.startedAt));
    }

    // La jornada indicada existe, es del usuario y sigue abierta
    function isOpenShift(userId, shiftId) {
      return get(/databases/$(database)/documents/users/$(userId)/shifts/$(shiftId)).data.endedAt == null;
    }

    // Forma válida del documento del reloj: un único campo con la hora del servidor
    function isValidClockSync(data) {
      return data.keys().hasAll(['syncedAt']) &&
             data.keys().hasOnly(['syncedAt']) &&
             data.syncedAt == request.time;
    }

    // Nombre de una empresa o de una persona: texto de 1 a 60 caracteres
    function isValidName(name) {
      return name is string && name.size() > 0 && name.size() <= 60;
    }

    // El usuario con sesión iniciada es el responsable de esa empresa
    function isCompanyOwner(companyId) {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    // El usuario con sesión iniciada es el responsable de la empresa a la que pertenece {userId}.
    // Si {userId} no está en ninguna empresa, su documento no existe y la comprobación falla
    function isManagerOf(userId) {
      let companyId = get(/databases/$(database)/documents/users/$(userId)).data.companyId;
      return isCompanyOwner(companyId);
    }

    // Tras la escritura en curso, {userId} queda vinculado a esa empresa. Se usa getAfter porque
    // el vínculo se guarda en dos documentos a la vez (un lote) y cada uno comprueba al otro
    function isLinkedAfter(userId, companyId) {
      return getAfter(/databases/$(database)/documents/users/$(userId)).data.companyId == companyId &&
             existsAfter(/databases/$(database)/documents/companies/$(companyId)/members/$(userId));
    }

    // ---------- Empresa del usuario ----------

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Unirse a una empresa: solo uno mismo, y solo si a la vez queda dado de alta en su equipo.
      // Al no poder modificarse ni borrarse, cada persona pertenece como mucho a una empresa
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['companyId']) &&
                       request.resource.data.keys().hasOnly(['companyId']) &&
                       request.resource.data.companyId is string &&
                       isLinkedAfter(userId, request.resource.data.companyId);

      allow update, delete: if false;
    }

    // ---------- Empresas ----------

    match /companies/{companyId} {
      // Se puede leer una empresa concreta (para enseñar su nombre al aceptar una invitación),
      // pero no listarlas: sin conocer el id no se llega a ninguna
      allow get: if isAuthenticated();

      // Crear una empresa: quien la crea queda como responsable y, en la misma escritura,
      // como miembro de su equipo. Así nadie puede ser responsable de dos empresas
      allow create: if isAuthenticated() &&
                       request.resource.data.keys().hasAll(['name', 'ownerId', 'createdAt']) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt']) &&
                       isValidName(request.resource.data.name) &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.createdAt == request.time &&
                       isLinkedAfter(request.auth.uid, companyId);

      allow update, delete: if false;

      // ---------- Equipo ----------

      match /members/{memberId} {
        // El responsable ve a todo el equipo; cada empleado, solo su propia ficha
        allow read: if isOwner(memberId) || isCompanyOwner(companyId);

        // Darse de alta en el equipo: solo uno mismo, con su propio correo y la hora del servidor.
        // La empresa tiene que existir y el usuario debe quedar vinculado a ella
        allow create: if isOwner(memberId) &&
                         request.resource.data.keys().hasAll(['name', 'email', 'joinedAt']) &&
                         request.resource.data.keys().hasOnly(['name', 'email', 'joinedAt']) &&
                         isValidName(request.resource.data.name) &&
                         request.resource.data.email == request.auth.token.email &&
                         request.resource.data.joinedAt == request.time &&
                         existsAfter(/databases/$(database)/documents/companies/$(companyId)) &&
                         isLinkedAfter(memberId, companyId);

        allow update, delete: if false;
      }
    }

    // ---------- Reloj del servidor ----------

    match /users/{userId}/private/clock {
      allow read: if isOwner(userId);

      // Se puede crear y sobrescribir, pero solo con la hora real del servidor
      allow create, update: if isOwner(userId) && isValidClockSync(request.resource.data);

      allow delete: if false;
    }

    // ---------- Jornadas ----------

    match /users/{userId}/shifts/{shiftId} {
      // Cada empleado ve sus propias jornadas, y el responsable de su empresa también.
      // El responsable solo puede leer: los fichajes los hace siempre el empleado
      allow read: if isOwner(userId) || isManagerOf(userId);

      // Fichar entrada: jornada nueva, abierta, con la hora del servidor.
      // Exigir request.time impide inventarse una hora de entrada
      allow create: if isOwner(userId) &&
                       isValidShift(request.resource.data) &&
                       request.resource.data.startedAt == request.time &&
                       request.resource.data.endedAt == null;

      // Fichar salida: solo se puede cerrar una jornada que sigue abierta, con la hora
      // del servidor y sin tocar la hora de entrada. Una jornada cerrada no se puede editar
      allow update: if isOwner(userId) &&
                       isValidShift(request.resource.data) &&
                       resource.data.endedAt == null &&
                       request.resource.data.startedAt == resource.data.startedAt &&
                       request.resource.data.endedAt == request.time;

      // Los fichajes son un registro laboral: no se borran desde la app
      allow delete: if false;
    }

    // ---------- Pausas ----------

    match /users/{userId}/breaks/{breakId} {
      // Igual que las jornadas: las ven el empleado y el responsable de su empresa
      allow read: if isOwner(userId) || isManagerOf(userId);

      // Empezar una pausa: solo dentro de una jornada propia que siga abierta,
      // y con la hora del servidor
      allow create: if isOwner(userId) &&
                       isValidBreak(request.resource.data) &&
                       request.resource.data.startedAt == request.time &&
                       request.resource.data.endedAt == null &&
                       isOpenShift(userId, request.resource.data.shiftId);

      // Terminar una pausa: solo una que siga abierta, con la hora del servidor
      // y sin cambiar ni su inicio ni la jornada a la que pertenece
      allow update: if isOwner(userId) &&
                       isValidBreak(request.resource.data) &&
                       resource.data.endedAt == null &&
                       request.resource.data.shiftId == resource.data.shiftId &&
                       request.resource.data.startedAt == resource.data.startedAt &&
                       request.resource.data.endedAt == request.time;

      // Las pausas forman parte del registro laboral: no se borran desde la app
      allow delete: if false;
    }
  }
}
